# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ──
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ── Next.js Build & Cache ──
/.next/
/out/
/build
/dist
/.turbo

# ── Environment Files ──
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# ── Prisma & Database Artifacts ──
*.db
*.sqlite
*.sqlite-journal
prisma/*.db
/src/generated/prisma

# ── Logs & Debugging ──
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ── OS & System Files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo

# ── IDE & Editor Folders ──
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ── Testing & Coverage ──
/coverage

# ── TypeScript & Next ──
*.tsbuildinfo
next-env.d.ts

# ── Deployment & Cloud Services ──
.vercel

# ── Temporary Helper Scripts ──
/src/scripts/check_users.ts
